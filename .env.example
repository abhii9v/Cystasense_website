# CystaSense Environment Configuration
# Copy this file to .env and fill in your values

# Required - Session secret for Flask sessions (use a long random string)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=your_super_secret_key_here

# Database Configuration
# For SQLite (default - good for local development):
# DATABASE_URL=sqlite:///pcod_app.db

# For PostgreSQL (recommended for production):
# Format: postgresql://username:password@host:port/database
# Example local: postgresql://postgres:password@localhost:5432/cystasense
# Example remote: postgresql://user:pass@db.example.com:5432/cystasense
DATABASE_URL=

# OpenAI API Configuration (optional - required for AI Health Assistant)
OPENAI_API_KEY=your_openai_api_key_here

# Flask Environment (optional)
# Set to 'development' for debug mode and verbose logging
# Set to 'production' for production deployment
FLASK_ENV=development

# PostgreSQL Connection Pool Settings (optional - for fine-tuning)
# SQLALCHEMY_POOL_SIZE=5
# SQLALCHEMY_MAX_OVERFLOW=10
# SQLALCHEMY_POOL_TIMEOUT=30
